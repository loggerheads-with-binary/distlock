# distlock server configuration.
#
#   cp .env.example .env      # .env is git-ignored
#
# All values below are the defaults, so this file works as-is once config/users.json exists.
# Durations are milliseconds (_MS), sizes are bytes (_BYTES). There are no secrets in the
# server's environment: credentials live (bcrypt-hashed) in the users file.

# ---------------------------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------------------------

# Address to listen on. There is no TLS yet: bind to a private interface only, never 0.0.0.0 on
# an untrusted network.
DISTLOCK_BIND_ADDR=127.0.0.1:7878

# Hard cap on concurrently open TCP connections (all sessions together).
DISTLOCK_MAX_CONNECTIONS=10000

# Largest accepted protobuf frame. Advertised to clients in HelloOk/AttachOk.
DISTLOCK_MAX_FRAME_BYTES=1048576

# A new connection must send Hello or Attach within this long, or it is closed.
DISTLOCK_HANDSHAKE_TIMEOUT_MS=5000

# Heartbeat. Clients are told to Ping at least this often (the shipped clients ping at half of it,
# and treat a full interval of silence from the server as a dead connection)...
DISTLOCK_PING_INTERVAL_MS=10000

# ...and the server closes a connection that has been silent for this long. Keep it >= 2x the ping interval.
DISTLOCK_IDLE_CONNECTION_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------------------------
# Authentication and sessions
# ---------------------------------------------------------------------------------------------

# JSON file with client_ids and bcrypt password hashes. Schema: config/users.schema.json,
# template: config/users.example.json. Create hashes with scripts/hash-password.sh.
DISTLOCK_USERS_FILE=./config/users.json

# bcrypt is deliberately slow (~250 ms at cost 12). At most this many verifications run at once
# (on the blocking thread pool); further Hello requests wait. Protects the CPU from login floods.
DISTLOCK_AUTH_MAX_CONCURRENT_BCRYPT=4

# Connections that may attach to one session (the client's pool size, plus reconnect slack).
DISTLOCK_MAX_CONNECTIONS_PER_SESSION=32

# A session with no connection, no held locks and no pending requests is deleted after this long.
# Sessions that still hold locks live until those leases expire. Clients must reconnect (Attach)
# within this window to resume.
DISTLOCK_SESSION_IDLE_TIMEOUT_MS=60000

# ---------------------------------------------------------------------------------------------
# Lock limits and behaviour (these map 1:1 onto distlock_core::Config)
# ---------------------------------------------------------------------------------------------

# Longest lease, both when granted and per Extend call.
DISTLOCK_MAX_TTL_MS=60000

# Longest an Acquire may wait in the queue. Clients asking for more are capped, not rejected.
DISTLOCK_MAX_WAIT_MS=300000

# Cap on the TOTAL life of one grant across all extensions, so a stuck-but-alive client cannot
# renew forever. Empty = unbounded.
DISTLOCK_MAX_HOLD_MS=

# After a mutex/write lease EXPIRES (not a graceful release), nobody is granted that name for this
# long, giving the dead holder's in-flight work time to drain. 0 disables.
DISTLOCK_LOCK_DELAY_MS=5000

# How long a holder's state tag (SUCCEEDED/FAILED/STORED/ABANDONED) stays readable to the next
# acquirer, when the releaser does not say, and the most a releaser may ask for.
DISTLOCK_DEFAULT_STATE_TTL_MS=600000
DISTLOCK_MAX_STATE_TTL_MS=86400000

DISTLOCK_MAX_NAME_LEN=256
DISTLOCK_MAX_WAITERS_PER_LOCK=10000
DISTLOCK_MAX_REQUESTS_PER_SESSION=10000

# Events (named broadcasts). A `set` wakes everyone waiting for the name and returns how many there
# were. For the publish window after it, the event also counts as published: a wait that arrives
# then returns at once with the same value. After the window the event is gone, and waiters wait for
# the next set. A set that does not say gets the default window; a longer one is capped, not rejected.
# A window of 0 wakes only the clients already waiting. Waits are limited by DISTLOCK_MAX_WAIT_MS,
# DISTLOCK_MAX_WAITERS_PER_LOCK (per event name) and DISTLOCK_MAX_REQUESTS_PER_SESSION.
DISTLOCK_EVENT_DEFAULT_PUBLISH_MS=10000
DISTLOCK_EVENT_MAX_PUBLISH_MS=600000
DISTLOCK_MAX_EVENT_VALUE_BYTES=4096

# State is memory-only, so after a restart the server refuses Acquire for this long, letting leases
# granted by the previous process run out. MUST be >= DISTLOCK_MAX_TTL_MS in production.
# Set 0 for local development to skip the wait.
DISTLOCK_STARTUP_GRACE_MS=60000

# ---------------------------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------------------------

# tracing EnvFilter syntax, e.g. "info" or "info,distlock_server=debug,distlock_core=trace".
RUST_LOG=info

# "text" (human-readable) or "json" (one object per line, for log shippers).
DISTLOCK_LOG_FORMAT=text

# ---------------------------------------------------------------------------------------------
# Client side (NOT read by the server). The Python client reads one URL from the environment with
# `DistLockClient.from_env()`; put it in the *client application's* environment, not the server's.
# client_id:password are a user from the server's users file (the plaintext password whose bcrypt
# hash is stored there). Percent-encode special characters in them (`@` as %40, `:` as %3A).
# The path is the namespace (a prefix that keeps applications' lock names apart); the query is
# optional: pool_size (TCP connections, default 4), default_ttl (lease seconds, default 30).
# ---------------------------------------------------------------------------------------------

# DISTLOCK_URL=distlock://billing-service:change-me@127.0.0.1:7878/billing?pool_size=4&default_ttl=30
